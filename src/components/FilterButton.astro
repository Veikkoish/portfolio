---
import type { Category } from '../config/colors';

interface Props {
  category: Category;
  label: string;
  color?: string;
}

const { category, label, color } = Astro.props;
---

<button
  class="filter-btn px-4 md:px-6 py-2 rounded-full text-sm md:text-base font-medium transition-all duration-300 hover:scale-105"
  data-category={category}
  style={color ? `--btn-color: ${color}` : undefined}
>
  {label}
</button>

<style>
  .filter-btn {
    background-color: rgba(18, 17, 21, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      inset 0 0 10px rgba(200, 200, 200, 0.06),
      0 2px 10px rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Slightly softened so buttons don’t overpower tags */
  .filter-btn[data-category="hardware"] {
    color: color-mix(in srgb, var(--color-hardware) 90%, var(--color-bg-dark));
  }

  .filter-btn[data-category="hardware"]:hover,
  .filter-btn[data-category="hardware"].active {
    background-color: color-mix(in srgb, var(--color-hardware) 82%, var(--color-bg-dark));
    color: var(--color-text);
  }

  .filter-btn[data-category="software"] {
    color: color-mix(in srgb, var(--color-software) 90%, var(--color-bg-dark));
  }

  .filter-btn[data-category="software"]:hover,
  .filter-btn[data-category="software"].active {
    background-color: color-mix(in srgb, var(--color-software) 82%, var(--color-bg-dark));
    color: #000;
  }

  .filter-btn[data-category="mechanical"] {
    color: color-mix(in srgb, var(--color-mechanical) 90%, var(--color-bg-dark));
  }

  .filter-btn[data-category="mechanical"]:hover,
  .filter-btn[data-category="mechanical"].active {
    background-color: color-mix(in srgb, var(--color-mechanical) 82%, var(--color-bg-dark));
    color: var(--color-text);
  }

  .filter-btn[data-category="all"] {
    color: var(--color-text-secondary);
  }

  .filter-btn[data-category="all"]:hover,
  .filter-btn[data-category="all"].active {
    background-color: var(--color-text-secondary);
    color: var(--color-bg-dark);
  }

  .filter-btn.active {
    transform: scale(1.05);
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow:
      inset 0 0 10px rgba(200, 200, 200, 0.08),
      0 4px 14px rgba(0, 0, 0, 0.3);
  }
</style>

