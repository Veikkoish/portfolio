---
import type { Category } from '../config/colors';

interface Props {
  category: Category;
  label: string;
  color?: string;
}

const { category, label, color } = Astro.props;
---

<button
  class="filter-btn px-4 md:px-6 py-2 rounded-full text-sm md:text-base font-medium transition-all duration-300 hover:scale-105"
  data-category={category}
  style={color ? `--btn-color: ${color}` : undefined}
>
  {label}
</button>

<style>
  .filter-btn {
    background-color: transparent;
    border: 2px solid transparent;
    --muted-hardware:rgb(53, 105, 225);
    --muted-software:rgb(45, 153, 128);
    --muted-mechanical:rgb(202, 125, 32);
  }

  .filter-btn[data-category="hardware"] {
    border-color: var(--muted-hardware);
    color: var(--muted-hardware);
  }

  .filter-btn[data-category="hardware"]:hover,
  .filter-btn[data-category="hardware"].active {
    background-color: var(--muted-hardware);
    color: var(--color-text);
  }

  .filter-btn[data-category="software"] {
    border-color: var(--muted-software);
    color: var(--muted-software);
  }

  .filter-btn[data-category="software"]:hover,
  .filter-btn[data-category="software"].active {
    background-color: var(--muted-software);
    color: #000;
  }

  .filter-btn[data-category="mechanical"] {
    border-color: var(--muted-mechanical);
    color: var(--muted-mechanical);
  }

  .filter-btn[data-category="mechanical"]:hover,
  .filter-btn[data-category="mechanical"].active {
    background-color: var(--muted-mechanical);
    color: var(--color-text);
  }

  .filter-btn[data-category="all"] {
    border-color: var(--color-text-secondary);
    color: var(--color-text-secondary);
  }

  .filter-btn[data-category="all"]:hover,
  .filter-btn[data-category="all"].active {
    background-color: var(--color-text-secondary);
    color: var(--color-bg-dark);
  }

  .filter-btn.active {
    transform: scale(1.05);
  }
</style>

