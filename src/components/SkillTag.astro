---
import type { Category } from '../config/colors';

interface Props {
  name: string;
  category: Exclude<Category, 'all'>;
}

const { name, category } = Astro.props;
---

<span
  class="skill-tag px-2.5 md:px-4 py-1 md:py-1.5 rounded-full text-xs md:text-sm font-medium"
  data-category={category}
>
  {name}
</span>

<style>
  .skill-tag {
    display: inline-block;
    white-space: nowrap;
    box-shadow:
      0 2px 6px rgba(18, 16, 20, 0.45),
      inset 1px 1px 2px rgba(255, 255, 255, 0.08),
      inset -1px -1px 2px rgba(18, 16, 20, 0.35);
  }
  .skill-tag[data-category="hardware"] {
    color: var(--color-hardware);
    background-color: color-mix(in srgb, var(--color-hardware) 18%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--color-hardware) 80%, transparent);
  }
  .skill-tag[data-category="software"] {
    color: var(--color-software);
    background-color: color-mix(in srgb, var(--color-software) 18%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--color-software) 65%, transparent);
  }
  .skill-tag[data-category="mechanical"] {
    color: var(--color-mechanical);
    background-color: color-mix(in srgb, var(--color-mechanical) 18%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--color-mechanical) 65%, transparent);
  }
</style>

